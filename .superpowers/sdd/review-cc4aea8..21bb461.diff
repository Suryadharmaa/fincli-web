+  .workflow-step::after { display: none; }
+  .feature-grid { grid-template-columns: 1fr; }
+  .feature-card, .feature-card:nth-child(1), .feature-card:nth-child(2), .feature-card:last-child { grid-column: 1; min-height: 290px; }
+  .local-first-band { grid-template-columns: 1fr; }
+  .local-first-band > p { grid-column: auto; }
+  .web-chamber-bar { padding-inline: 10px; }
+  .local-address { margin-left: 12px; }
+  .web-window-actions > span { display: none; }
+  .web-chamber-layout { grid-template-columns: 1fr; }
+  .web-sidebar { display: none; }
+  .web-chat-scroll { min-height: 350px; }
+  .local-web-benefits { grid-template-columns: 1fr; }
+  .local-web-benefits > div { border-right: 0; border-bottom: 1px solid var(--line); }
+  .local-web-benefits > div:last-child { border-bottom: 0; }
+  .report-evidence-grid { grid-template-columns: 1fr; }
+  .active-stage-card { grid-template-columns: auto 1fr; }
+  .active-stage-card > strong { grid-column: 2; }
+  .research-principles { grid-template-columns: 1fr; }
+  .research-principles > div { border-right: 0; border-bottom: 1px solid var(--line); }
+  .provider-matrix { overflow-x: auto; overscroll-behavior-inline: contain; }
+  .provider-columns, .provider-row { min-width: 760px; grid-template-columns: 1.3fr .55fr .8fr .75fr .65fr .8fr; }
+  .trading-grid { grid-template-columns: 1fr; }
+  .safety-ledger { grid-column: auto; display: block; }
+  .ledger-row { border-right: 0; border-bottom: 1px solid var(--line-soft); }
+  .security-vault-band { grid-template-columns: 1fr; }
+  .vault-visual { width: 95px; }
+  .vault-controls { grid-column: auto; grid-template-columns: 1fr; }
+  .install-console { grid-template-columns: 1fr; }
+  .install-tabs { flex-direction: row; padding: 8px; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line); }
+  .install-tabs::before { display: none; }
+  .install-tabs button { flex: 0 0 auto; }
+  .install-panel { padding: 18px; }
+  .install-steps i { width: 16px; }
+  .ecosystem-modules { grid-template-columns: 1fr; }
+  .registry-toolbar { grid-template-columns: 1fr; }
+  .registry-count { justify-self: end; }
+  .command-row { grid-template-columns: minmax(0,1fr) 64px; gap: 8px; }
+  .command-category { grid-column: 1; font-size: .43rem; }
+  .command-row code { grid-column: 1; }
+  .copy-state { grid-column: 2; grid-row: 1/3; }
+  .release-entry { grid-template-columns: 58px 1fr; gap: 12px; padding-block: 22px; }
+  .release-entry > p { grid-column: 2; }
+  .current-badge { grid-column: 2; width: fit-content; }
+  .final-cta { min-height: auto; grid-template-columns: 1fr; padding: 34px 24px; }
+  .final-cta-ornament { display: none; }
+  .final-cta-copy { padding: 0; }
+  .final-cta-command { grid-column: auto; margin: 0; }
+  .footer-grid { grid-template-columns: 1fr; gap: 40px; }
+  .footer-bottom { align-items: flex-start; flex-direction: column; }
+}
+
+@media (max-width: 460px) {
+  .brand-version { display: none; }
+  .release-pill > span:last-child { display: none; }
+  .hero h1 { font-size: 3.25rem; }
+  .console-report { padding: 14px; }
+  .console-output-topline { padding-inline: 14px; }
+  .console-metrics { grid-template-columns: 1fr; }
+  .console-metrics > div { border-right: 0; border-bottom: 1px solid var(--line); }
+  .console-input { padding: 9px; }
+  .console-input .console-run { padding-inline: 9px; }
+  .feature-card { padding: 21px; }
+  .local-address { max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .web-chat-header button { display: none; }
+  .research-stages { grid-template-columns: repeat(4,120px); }
+  .report-header > div:last-child { display: none; }
+  .matrix-row { grid-template-columns: 54px minmax(0,1fr) 36px; gap: 6px; }
+  .report-footer { grid-template-columns: 1fr; }
+  .provider-matrix-header small { display: none; }
+  .security-vault-band { padding: 22px; }
+  .install-panel-copy { flex-direction: column; }
+  .install-steps { gap: 5px; }
+  .install-steps i { width: 8px; }
+  .final-cta-copy h2 { font-size: 2.9rem; }
+  .footer-links { grid-template-columns: 1fr 1fr; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
+  .floating-market-card { animation: none; }
+  .reveal { opacity: 1; transform: none; }
+}

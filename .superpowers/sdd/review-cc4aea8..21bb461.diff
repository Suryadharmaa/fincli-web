+} from 'lucide-react'
+import { features, type FeatureKey } from '../data'
+import { Reveal, SectionHeading } from './Reveal'
+
+const icons: Record<FeatureKey, LucideIcon> = {
+  research: BrainCircuit,
+  provider: Network,
+  risk: Shield,
+  trading: Swords,
+  backtest: FlaskConical,
+  security: LockKeyhole,
